# Real retailer receipts used for local testing — contain a live retailer ID
# and financial figures, so they are deliberately not committed.
frontend/public/samples/

# Ground truth transcribes those same receipts line by line — the retailer's
# pack codes, settled dates and weekly figures — so committing it would put back
# exactly what excluding the images keeps out. Keep it local, or rebuild it from
# a redacted receipt before committing.
frontend/tools/fixtures/ground-truth.json

# Reader output: the contents of whatever receipt was last read.
frontend/tools/out/

# The regression corpus: whole customer invoices, account numbers and prices
# included, plus the snapshot of how each one currently reads. Kept local for
# the same reason as the samples above. `tools/corpus.test.ts` is committed and
# skips when the directory is empty.
frontend/tools/corpus/
frontend/dist/

# Python virtualenv for python/
.venv/
__pycache__/
